# =============================================================================
# RAG Application Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# IMPORTANT: Never commit your .env file to version control!
# =============================================================================


# -----------------------------------------------------------------------------
# VOLCENGINE ARK - Text Embeddings (Required for semantic search)
# -----------------------------------------------------------------------------
# These credentials are used to generate vector embeddings for documents and
# search queries, enabling semantic/similarity search in Elasticsearch.
#
# Service: Volcengine Ark (火山引擎方舟)
# Model: Doubao Embedding (豆包向量模型)
# Console: https://console.volcengine.com/ark
#
# How to get these:
#   1. Log in to Volcengine console: https://console.volcengine.com/ark
#   2. Create an API Key:
#      - Go to "API Key 管理" in the left sidebar
#      - Click "创建 API Key"
#      - Copy the generated key (you won't be able to see it again!)
#   3. Create an Embedding Endpoint:
#      - Go to "模型推理" → "推理接入点管理"
#      - Click "创建推理接入点"
#      - Select an embedding model (e.g., "doubao-embedding" or "doubao-embedding-large")
#      - After creation, copy the endpoint ID (format: ep-YYYYMMDDHHMMSS-xxxxx)
#
# ARK_API_KEY: Your Volcengine Ark API key for authentication
# Example: ark-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ARK_API_KEY=your-volcengine-ark-api-key

# ARK_EMBEDDING_ENDPOINT: The inference endpoint ID for the embedding model
# This tells the API which deployed model to use for generating embeddings.
# It's passed as the "model" parameter in API requests.
# Format: ep-YYYYMMDDHHMMSS-xxxxx (e.g., ep-20251228171132-pgkpt)
ARK_EMBEDDING_ENDPOINT=ep-xxxxxxxxx-xxxxx


# -----------------------------------------------------------------------------
# ALIBABA DASHSCOPE - Qwen LLM Chat (Required for AI chat feature)
# -----------------------------------------------------------------------------
# This API key is used for the Qwen large language model that generates
# conversational responses in the chat feature. It takes retrieved document
# context and produces human-readable answers.
#
# Service: Alibaba Cloud DashScope (阿里云灵积)
# Model: Qwen (通义千问)
# Console: https://dashscope.console.aliyun.com
#
# How to get this:
#   1. Log in to DashScope console: https://dashscope.console.aliyun.com
#   2. Go to "API-KEY 管理" in the left sidebar
#   3. Click "创建新的 API-KEY"
#   4. Copy the generated key
#
# DASHSCOPE_API_KEY: Your Alibaba DashScope API key for Qwen LLM
# Example: sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_API_KEY=your-dashscope-api-key


# -----------------------------------------------------------------------------
# OPTIONAL SETTINGS
# -----------------------------------------------------------------------------

# ARK_BASE_URL: Custom Volcengine Ark API base URL (optional)
# Default: https://ark.cn-beijing.volces.com/api/v3
# Only change if you need to use a different region or custom endpoint.
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
